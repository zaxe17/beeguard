# Flask
FLASK_ENV=
FLASK_DEBUG=
PORT=8000
SECRET_KEY=
JWT_SECRET=
JWT_EXPIRES_HOURS=

# Database Connection
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# CORS
FRONTEND_ORIGIN=

# ── NEW: SMTP for email verification ─────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=

# ── NEW: OTP behavior ────────────────────────────────────
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Yield Analytics
QUEEN_MAX_AGE_DAYS=730
YIELD_REPLACE_THRESHOLD_PCT=60

# ── Computer Vision (local YOLO — replaces Roboflow) ─────
# Optional overrides — defaults in config.py already point to
# weights/best.pt, conf 0.4, cpu, imgsz 1024. Uncomment to change.
# CV_SCAN_MODEL_PATH=weights/best.pt
# CV_SCAN_CONF_THRESHOLD=0.4
# CV_SCAN_DEVICE=cpu
# CV_SCAN_IMGSZ=1024

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=